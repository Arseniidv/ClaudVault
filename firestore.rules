rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Сессии QR-переноса подключений.
    //
    // Клиент может только создать pending-сессию и читать свои документы.
    // Запись trustedPublicKey/encryptedPayload/status=approved выполняет
    // исключительно Cloud Function submitDeviceTransferPayload
    // (Admin SDK обходит эти правила).
    match /qr_verification_sessions/{sessionID} {
      allow read: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;

      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasAll([
          'ownerUid', 'deviceBPublicKey', 'status', 'createdAt', 'expiresAt'
        ])
        // expiresAt обязан быть timestamp не дальше чем через 15 минут
        // от серверного времени — клиентские часы могут врать.
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt <= request.time + duration.value(900, 's')
        && request.resource.data.createdAt is timestamp
        && !request.resource.data.keys().hasAny([
          'trustedPublicKey', 'encryptedPayload', 'approvedAt'
        ]);

      // Обновление запрещено: approved-пакет пишет только backend.
      allow update: if false;

      // Удаление разрешено владельцу — нужно для отмены сессии
      // и очистки документа после получения пакета.
      allow delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
    }

    // OTP, сброс пароля и окна верификации обслуживаются только
    // Cloud Functions через Admin SDK.
    match /otps/{document} {
      allow read, write: if false;
    }

    match /password_resets/{document} {
      allow read, write: if false;
    }

    match /verifications/{document} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
